{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clientSecret": {
      "type": "string",
      "minLength": 16,
      "maxLength": 4096
    },
    "cookieSecret": {
      "type": "string",
      "minLength": 40,
      "maxLength": 128
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "clientSecret",
    "cookieSecret"
  ]
}
