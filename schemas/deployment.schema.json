{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "vmSize": {
      "enum": [
        "Standard_B1ms",
        "Standard_B2als_v2"
      ]
    },
    "monthlyBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dailyRetentionDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 9999
        },
        "instantRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "dailyRetentionDays",
        "instantRetentionDays"
      ]
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memoryPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "cpuCredits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "memoryPercent",
        "cpuCredits"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runCommandDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "runtimeRevisions": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "auditDays": {
          "type": "integer",
          "minimum": 30,
          "maximum": 730
        }
      },
      "required": [
        "runCommandDays",
        "runtimeRevisions",
        "auditDays"
      ]
    },
    "optional": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retainedRecovery": {
          "type": "boolean"
        },
        "fileShareBackups": {
          "type": "boolean"
        },
        "auditLogging": {
          "type": "boolean"
        }
      },
      "required": [
        "retainedRecovery",
        "fileShareBackups",
        "auditLogging"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "vmSize",
    "monthlyBudget",
    "backup",
    "monitor",
    "retention",
    "optional"
  ]
}
